        "{\"version\": 1, \"assets\": [{\"id\": \"reference-1\", \"name\": \"Reference 1\", \"image\": \"shot-workspace-example-1.png\", \"description\": \"A single blue rounded block on a neutral studio tabletop.\"}, {\"id\": \"reference-2\", \"name\": \"Reference 2\", \"image\": \"shot-workspace-example-2.png\", \"description\": \"A single red rounded block on a neutral studio tabletop.\"}], \"shots\": [{\"id\": \"example-shot\", \"title\": \"Example continuation\", \"brief\": \"Continue a gentle camera move past colored blocks on a neutral studio table. No dialogue or music.\", \"duration_s\": 3, \"width\": 704, \"height\": 480, \"refs\": [{\"asset_id\": \"reference-1\", \"role\": \"reference\", \"notes\": \"\"}, {\"asset_id\": \"reference-2\", \"role\": \"reference\", \"notes\": \"\"}], \"prompt_sections\": {\"subject_definitions\": \"<Picture 1> defines the blue block. <Picture 2> defines the red block.\", \"summary\": \"Continue the same gentle camera movement through a quiet tabletop scene.\", \"retention_analysis\": \"Keep the block colors, rounded shapes, tabletop, lighting and camera direction consistent.\", \"detailed_description\": \"0–3.000 seconds: a steady slow side-tracking view passes the colored blocks on the neutral tabletop. Preserve the incoming composition and motion where a prior source is connected. No speaking.\", \"overall_soundscape\": \"Quiet room tone. No speech.\", \"non_diegetic_music\": \"None\"}, \"prompt_basis\": {\"title\": \"Example continuation\", \"brief\": \"Continue a gentle camera move past colored blocks on a neutral studio table. No dialogue or music.\", \"duration_s\": 3.0, \"width\": 704, \"height\": 480, \"references\": [{\"picture_index\": 1, \"asset_id\": \"reference-1\", \"name\": \"Reference 1\", \"image\": \"shot-workspace-example-1.png\", \"description\": \"A single blue rounded block on a neutral studio tabletop.\", \"role\": \"reference\", \"binding_notes\": \"\"}, {\"picture_index\": 2, \"asset_id\": \"reference